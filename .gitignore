# Local configuration and secrets - never committed
/app/config.php
/app/secrets/*
!/app/secrets/.gitkeep
recovery_codes.txt

# Composer. vendor/ is built on the server by Plesk's PHP Composer from the committed composer.lock.
# composer.lock IS committed: Composer Install builds vendor/ from it, so every build gets the same versions.
/vendor/

# Tooling
.phpunit.result.cache
.phpunit.cache/
/tests/.tmp/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
docs/PHP 8.2.34 - phpinfo().pdf
CLAUDE.local.md
